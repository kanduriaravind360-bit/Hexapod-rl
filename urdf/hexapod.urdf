    <!-- ================= ADDED: UPPER PLATE =================
         Layout:  electronics  (on top of the upper plate)
                  upper plate  80 x 140 x 3 mm, z = 49.5 .. 52.5 mm
                  battery      (between the frame and the upper plate)
                  frame / lower plate (base)
         Mass 45 g = PLA plate (~37 g) + 4 M3 standoffs at (+/-36, +/-50) mm, standing on the top stiffeners. Weigh yours and update. -->
    <link name="top_plate">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.045" />
            <inertia ixx="7.3534e-05" iyy="2.4034e-05" izz="9.7500e-05" ixy="0" iyz="0" ixz="0" />
        </inertial>
        <visual name="top_plate_visual">
            <geometry><box size="0.08 0.14 0.003" /></geometry>
            <material name="orange"/>
        </visual>
        <visual name="standoff_0">
            <origin xyz="0.0360 0.0500 -0.0157" rpy="0 0 0" />
            <geometry><cylinder radius="0.0025" length="0.0283" /></geometry>
            <material name="gray"/>
        </visual>
        <visual name="standoff_1">
            <origin xyz="-0.0360 0.0500 -0.0157" rpy="0 0 0" />
            <geometry><cylinder radius="0.0025" length="0.0283" /></geometry>
            <material name="gray"/>
        </visual>
        <visual name="standoff_2">
            <origin xyz="0.0360 -0.0500 -0.0177" rpy="0 0 0" />
            <geometry><cylinder radius="0.0025" length="0.0323" /></geometry>
            <material name="gray"/>
        </visual>
        <visual name="standoff_3">
            <origin xyz="-0.0360 -0.0500 -0.0177" rpy="0 0 0" />
            <geometry><cylinder radius="0.0025" length="0.0323" /></geometry>
            <material name="gray"/>
        </visual>
        <collision name="top_plate_collision">
            <geometry><box size="0.08 0.14 0.003" /></geometry>
        </collision>
    </link>
    <joint name="base_top_plate" type="fixed">
        <parent link="base" />
        <child link="top_plate" />
        <origin xyz="0 0 0.0510" rpy="0 0 0" />
    </joint>


    <!-- ================= ELECTRONICS (on top of the upper plate) =================
         Simple boxes with measured-ish sizes and masses. Weigh your boards and update.
         esp32        ESP32 DevKit (38-pin)          55 x 28 mm,   ~10 g
         mpu6050      GY-521 MPU6050 breakout        21 x 16 mm,   ~2 g   (IMU frame is on this board)
         pwm_driver_* 16-ch PCA9685-size board        62.5 x 25.4 mm, ~9 g each
         All sit on 3 mm spacers on the upper plate. -->

    <link name="esp32">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.01" />
            <inertia ixx="2.604e-06" iyy="7.367e-07" izz="3.174e-06" ixy="0" iyz="0" ixz="0" />
        </inertial>
        <visual>
            <geometry><box size="0.028 0.055 0.01" /></geometry>
            <material name="esp_black"/>
        </visual>
        <collision>
            <geometry><box size="0.028 0.055 0.01" /></geometry>
        </collision>
    </link>
    <joint name="top_plate_esp32" type="fixed">
        <parent link="top_plate" />
        <child link="esp32" />
        <origin xyz="0.0 0.04 0.0095" rpy="0 0 0" />
    </joint>

    <link name="mpu6050">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.002" />
            <inertia ixx="4.417e-08" iyy="7.500e-08" izz="1.162e-07" ixy="0" iyz="0" ixz="0" />
        </inertial>
        <visual>
            <geometry><box size="0.021 0.016 0.003" /></geometry>
            <material name="imu_blue"/>
        </visual>
        <collision>
            <geometry><box size="0.021 0.016 0.003" /></geometry>
        </collision>
    </link>
    <joint name="top_plate_mpu6050" type="fixed">
        <parent link="top_plate" />
        <child link="mpu6050" />
        <origin xyz="0.0 0.0 0.0060" rpy="0 0 0" />
    </joint>

    <link name="pwm_driver_1">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.009" />
            <inertia ixx="5.919e-07" iyy="3.038e-06" izz="3.414e-06" ixy="0" iyz="0" ixz="0" />
        </inertial>
        <visual>
            <geometry><box size="0.0625 0.0254 0.012" /></geometry>
            <material name="pwm_blue"/>
        </visual>
        <collision>
            <geometry><box size="0.0625 0.0254 0.012" /></geometry>
        </collision>
    </link>
    <joint name="top_plate_pwm_driver_1" type="fixed">
        <parent link="top_plate" />
        <child link="pwm_driver_1" />
        <origin xyz="0.0 -0.024 0.0105" rpy="0 0 0" />
    </joint>

    <link name="pwm_driver_2">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.009" />
            <inertia ixx="5.919e-07" iyy="3.038e-06" izz="3.414e-06" ixy="0" iyz="0" ixz="0" />
        </inertial>
        <visual>
            <geometry><box size="0.0625 0.0254 0.012" /></geometry>
            <material name="pwm_blue"/>
        </visual>
        <collision>
            <geometry><box size="0.0625 0.0254 0.012" /></geometry>
        </collision>
    </link>
    <joint name="top_plate_pwm_driver_2" type="fixed">
        <parent link="top_plate" />
        <child link="pwm_driver_2" />
        <origin xyz="0.0 -0.053 0.0105" rpy="0 0 0" />
    </joint>

    <!-- IMU frame = the MPU6050 chip, on top of its board.
         SET rpy SO THE AXES MATCH THE X/Y ARROWS PRINTED ON YOUR GY-521 BOARD.
         NOTE: in this model the robot's front/back direction is along Y. -->
    <link name="imu_link" />
    <joint name="mpu6050_imu" type="fixed">
        <parent link="mpu6050" />
        <child link="imu_link" />
        <origin xyz="0 0 0.0015" rpy="0 0 0" />
    </joint>

    <!-- ================= ADDED: root, IMU sensor =================
         Joints are driven by the ros2_control block at the end of this file, not by Gazebo plugins. -->

    <!-- Massless root link (KDL / robot_state_publisher warn if the root link has inertia) -->
    <link name="base_footprint" />
    <joint name="base_footprint_base" type="fixed">
        <parent link="base_footprint" />
        <child link="base" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <gazebo reference="imu_link">
        <sensor name="imu" type="imu">
            <always_on>true</always_on>
            <update_rate>100</update_rate>
            <topic>/hexapod/imu</topic>
            <imu>
                <angular_velocity>
                    <x><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></z>
                </angular_velocity>
                <linear_acceleration>
                    <x><noise type="gaussian"><mean>0</mean><stddev>0.05</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0</mean><stddev>0.05</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0</mean><stddev>0.05</stddev></noise></z>
                </linear_acceleration>
            </imu>
        </sensor>
    </gazebo>

    <!-- ================= FEET =================
         Each foot is an 8 mm rubber-cap-like sphere sticking 5 mm out of the tibia tip.
         No contact sensors: for RL, read contacts straight from the physics engine
         (a leg is "down" if its tibia or foot touches the ground). -->

    <!-- Leg 1 foot: sphere at the tip of the tibia -->
    <link name="leg_1_foot">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.001" />
            <inertia ixx="1e-8" iyy="1e-8" izz="1e-8" ixy="0" iyz="0" ixz="0" />
        </inertial>
        <collision>
            <geometry><sphere radius="0.008" /></geometry>
        </collision>
    </link>
    <joint name="leg_1_foot_joint" type="fixed">
        <parent link="leg_1_tibia" />
        <child link="leg_1_foot" />
        <origin xyz="0.08615 0.09322 -0.03193" rpy="0 0 0" />
    </joint>
    <gazebo reference="leg_1_foot">
        <mu1>0.9</mu1>
        <mu2>0.9</mu2>
        <kp>1000000</kp>
        <kd>100</kd>
        <minDepth>0.0005</minDepth>
    </gazebo>

    <!-- Leg 2 foot: sphere at the tip of the tibia -->
    <link name="leg_2_foot">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.001" />
            <inertia ixx="1e-8" iyy="1e-8" izz="1e-8" ixy="0" iyz="0" ixz="0" />
        </inertial>
        <collision>
            <geometry><sphere radius="0.008" /></geometry>
        </collision>
    </link>
    <joint name="leg_2_foot_joint" type="fixed">
        <parent link="leg_2_tibia" />
        <child link="leg_2_foot" />
        <origin xyz="0.12684 0.00500 -0.03193" rpy="0 0 0" />
    </joint>
    <gazebo reference="leg_2_foot">
        <mu1>0.9</mu1>
        <mu2>0.9</mu2>
        <kp>1000000</kp>
        <kd>100</kd>
        <minDepth>0.0005</minDepth>
    </gazebo>

    <!-- Leg 3 foot: sphere at the tip of the tibia -->
    <link name="leg_3_foot">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.001" />
            <inertia ixx="1e-8" iyy="1e-8" izz="1e-8" ixy="0" iyz="0" ixz="0" />
        </inertial>
        <collision>
            <geometry><sphere radius="0.008" /></geometry>
        </collision>
    </link>
    <joint name="leg_3_foot_joint" type="fixed">
        <parent link="leg_3_tibia" />
        <child link="leg_3_foot" />
        <origin xyz="0.09322 -0.08615 -0.03193" rpy="0 0 0" />
    </joint>
    <gazebo reference="leg_3_foot">
        <mu1>0.9</mu1>
        <mu2>0.9</mu2>
        <kp>1000000</kp>
        <kd>100</kd>
        <minDepth>0.0005</minDepth>
    </gazebo>

    <!-- Leg 4 foot: sphere at the tip of the tibia -->
    <link name="leg_4_foot">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.001" />
            <inertia ixx="1e-8" iyy="1e-8" izz="1e-8" ixy="0" iyz="0" ixz="0" />
        </inertial>
        <collision>
            <geometry><sphere radius="0.008" /></geometry>
        </collision>
    </link>
    <joint name="leg_4_foot_joint" type="fixed">
        <parent link="leg_4_tibia" />
        <child link="leg_4_foot" />
        <origin xyz="-0.08615 -0.09322 -0.03193" rpy="0 0 0" />
    </joint>
    <gazebo reference="leg_4_foot">
        <mu1>0.9</mu1>
        <mu2>0.9</mu2>
        <kp>1000000</kp>
        <kd>100</kd>
        <minDepth>0.0005</minDepth>
    </gazebo>

    <!-- Leg 5 foot: sphere at the tip of the tibia -->
    <link name="leg_5_foot">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.001" />
            <inertia ixx="1e-8" iyy="1e-8" izz="1e-8" ixy="0" iyz="0" ixz="0" />
        </inertial>
        <collision>
            <geometry><sphere radius="0.008" /></geometry>
        </collision>
    </link>
    <joint name="leg_5_foot_joint" type="fixed">
        <parent link="leg_5_tibia" />
        <child link="leg_5_foot" />
        <origin xyz="-0.12684 -0.00500 -0.03193" rpy="0 0 0" />
    </joint>
    <gazebo reference="leg_5_foot">
        <mu1>0.9</mu1>
        <mu2>0.9</mu2>
        <kp>1000000</kp>
        <kd>100</kd>
        <minDepth>0.0005</minDepth>
    </gazebo>

    <!-- Leg 6 foot: sphere at the tip of the tibia -->
    <link name="leg_6_foot">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.001" />
            <inertia ixx="1e-8" iyy="1e-8" izz="1e-8" ixy="0" iyz="0" ixz="0" />
        </inertial>
        <collision>
            <geometry><sphere radius="0.008" /></geometry>
        </collision>
    </link>
    <joint name="leg_6_foot_joint" type="fixed">
        <parent link="leg_6_tibia" />
        <child link="leg_6_foot" />
        <origin xyz="-0.09322 0.08615 -0.03193" rpy="0 0 0" />
    </joint>
    <gazebo reference="leg_6_foot">
        <mu1>0.9</mu1>
        <mu2>0.9</mu2>
        <kp>1000000</kp>
        <kd>100</kd>
        <minDepth>0.0005</minDepth>
    </gazebo>

    <!-- ================= ros2_control =================
         18 revolute joints, position command + position/velocity/effort state.
         Joint order matches config/controllers.yaml exactly:
         leg_N_{coxa,femur,tibia}_joint for N = 1..6.
         No Gazebo JointPositionController plugins: gz_ros2_control owns the joints. -->
    <ros2_control name="HexapodSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <joint name="leg_1_coxa_joint">
            <command_interface name="position">
                <param name="min">-1.570796</param>
                <param name="max">1.570796</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="leg_1_femur_joint">
            <command_interface name="position">
                <param name="min">-1.570796</param>
                <param name="max">1.570796</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="leg_1_tibia_joint">
            <command_interface name="position">
                <param name="min">-2.181662</param>
                <param name="max">-0.0</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="leg_2_coxa_joint">
            <command_interface name="position">
                <param name="min">-1.570796</param>
                <param name="max">1.570796</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="leg_2_femur_joint">
            <command_interface name="position">
                <param name="min">-1.570796</param>
                <param name="max">1.570796</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="leg_2_tibia_joint">
            <command_interface name="position">
                <param name="min">-2.181662</param>
                <param name="max">-0.0</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="leg_3_coxa_joint">
            <command_interface name="position">
                <param name="min">-1.570796</param>
                <param name="max">1.570796</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="leg_3_femur_joint">
            <command_interface name="position">
                <param name="min">-1.570796</param>
                <param name="max">1.570796</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="leg_3_tibia_joint">
            <command_interface name="position">
                <param name="min">-2.181662</param>
                <param name="max">-0.0</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="leg_4_coxa_joint">
            <command_interface name="position">
                <param name="min">-1.570796</param>
                <param name="max">1.570796</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="leg_4_femur_joint">
            <command_interface name="position">
                <param name="min">-1.570796</param>
                <param name="max">1.570796</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="leg_4_tibia_joint">
            <command_interface name="position">
                <param name="min">-2.181662</param>
                <param name="max">-0.0</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="leg_5_coxa_joint">
            <command_interface name="position">
                <param name="min">-1.570796</param>
                <param name="max">1.570796</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="leg_5_femur_joint">
            <command_interface name="position">
                <param name="min">-1.570796</param>
                <param name="max">1.570796</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="leg_5_tibia_joint">
            <command_interface name="position">
                <param name="min">-2.181662</param>
                <param name="max">-0.0</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="leg_6_coxa_joint">
            <command_interface name="position">
                <param name="min">-1.570796</param>
                <param name="max">1.570796</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="leg_6_femur_joint">
            <command_interface name="position">
                <param name="min">-1.570796</param>
                <param name="max">1.570796</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="leg_6_tibia_joint">
            <command_interface name="position">
                <param name="min">-2.181662</param>
                <param name="max">-0.0</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
    </ros2_control>

    <gazebo>
        <plugin filename="gz_ros2_control-system"
                name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find hexapod_description)/config/controllers.yaml</parameters>
        </plugin>
    </gazebo>

</robot>
